{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Agent": {
    "Api": {
      "BaseUrl": "https://10.0.0.6:8443/", // Dirección HTTPS de nuestra plataforma web
      //"BaseUrl": "192.168.100.13",
      "TimeoutSeconds": 15, // Tiempo máximo previsto para una solicitud HTTP
      "CheckIntervalSeconds": 60, // Intervalo de supervisión de la API, en segundos
      "Token": ""
    },
    "Network": {
      "CheckIntervalSeconds": 30 // Intervalo de supervisión de red, en segundos
    },
    "Player": {
      "Informacion": {
        "Id": "1"
      }
    },
    "Commands": {
      // Intervalo en segundos para consultar si existen comandos pendientes a ejecutar por el player
      // estos enviados desde la plataforma web.
      "CheckIntervalSeconds": 5
    }
  }
}
